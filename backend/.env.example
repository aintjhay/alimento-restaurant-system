NODE_ENV=development
PORT=5000
# Generate a random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
# Atlas or a replica set is required; standalone MongoDB cannot commit transactions.
MONGODB_URI=mongodb://localhost:27017/alimento?replicaSet=rs0
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Password reset email (SMTP_PORT=465 uses TLS; 587 uses STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Set only to the exact number of trusted proxies in your deployment.
TRUST_PROXY_HOPS=0
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional development-only account for npm run dev:memory
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Optional explicit administrator creation/promotion via npm run migrate:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
PYTHON_EXE=
